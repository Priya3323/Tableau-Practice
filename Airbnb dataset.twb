      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' hidden='true' name='[Calculation_0654809066676224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Pricing Category' datatype='string' name='[Calculation_0654809068032001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;= 300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price]&gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0654809070145538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1873068283428864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1873068288995330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1873068287840257]&#13;&#10;THEN &quot;Above Limit&quot; &#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Bed Criteria' datatype='string' name='[Calculation_1873068291981316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds]&gt; [Parameters].[Parameter 1873068291547139] then &quot;Optimum number of beds&quot;&#13;&#10;ELSE &quot;Not Enough Bed&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel Count' datatype='integer' name='[Calculation_1873068295184389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Since_New' datatype='date' name='[Calculation_1873068296925190]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since], DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Property TYpe_new' datatype='string' name='[Calculation_1873068298842119]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type], &quot;Unknown&quot;)' />
      </column>
      <column caption='Review Scores Rating_new (bin)' datatype='integer' name='[Calculation_1873068300873736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating (bin)], 0)' />
      </column>
      <column caption='Review Scores Rating_new' datatype='integer' name='[Calculation_1873068301139977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating], 0)' />
      </column>
      <column caption='Review Performance Score_new' datatype='integer' name='[Calculation_1873068301398026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_0654809066676224], 0)' />
      </column>
